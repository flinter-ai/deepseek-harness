{
  "name": "@flinter/dsh-pes",
  "description": "Scaffold-only boundary for bounded searchable trace behavior",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --root ../../.. packages/flinter/dsh-pes/tests"
  }
}
